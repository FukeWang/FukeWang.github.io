% =====================================================================
% Publications (BibTeX)
% ---------------------------------------------------------------------
% Entries added below are rendered automatically on the /publications/
% page and the selected ones appear on the homepage.
%
% Tips:
%   - Export BibTeX from Google Scholar, DBLP, or Zotero and paste here.
%   - selected = {true} pins a paper to the "Selected publications"
%     section on the homepage.
%   - Optional per-entry links: pdf = {...}, code = {...},
%     website = {...}, preview = {...}
%
% Example entry (uncomment and adapt):

% @article{wang2025example,
%   abbr      = {EXAMPLE},
%   title     = {An Example Paper Title},
%   author    = {Wang, Fuke and Coauthor, A.},
%   journal   = {Example Journal},
%   year      = {2025},
%   selected  = {true}
% }
% =====================================================================